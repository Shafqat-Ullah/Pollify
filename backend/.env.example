PORT=5000
NODE_ENV=development

# MongoDB Atlas (REQUIRED - the app fails fast without it and never falls back to a local/in-memory DB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pollify?retryWrites=true&w=majority

# JWT - use long random strings, keep secret
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Client (CORS origin)
CLIENT_URL=http://localhost:5173

# Email SMTP (for OTP verification / password reset)
# In development with placeholder values, emails go to an Ethereal test inbox and
# the OTP is printed in the backend terminal. Set real credentials for production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Pollify <no-reply@pollify.app>
